@startuml
title Sistema de Controle de Lava Rápido - Diagrama de Classes
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "model" {
  class Cliente {
    - id: int
    - nome: String
    - cpf: String
    - telefone: String
    - email: String
  }
  class Veiculo {
    - id: int
    - cliente: Cliente
    - placaVeiculo: String
  }
  class TipoServico {
    - id: int
    - nome: String
    - descricao: String
    - preco: double
  }
  class Agendamento {
    - id: int
    - veiculo: Veiculo
    - tipoServico: TipoServico
    - dataHora: LocalDateTime
    - status: StatusAgendamento
  }
  enum StatusAgendamento {
    AGENDADO
    CANCELADO
    CONCLUIDO
  }
}

package "service" {
  class ServicoCliente
  class ServicoVeiculo {
    - veiculos: List<Veiculo>
    + listarTodos(): List<Veiculo>
    + listarPorCliente(clienteId: int): List<Veiculo>
    + adicionar(cliente, placaVeiculo): Veiculo
    + atualizar(id, cliente, placaVeiculo): void
    + excluir(id: int): void
  }
  class ServicoTipoServico
  class ServicoAgendamento
}

package "view" {
  class TelaCliente
  class TelaVeiculo
  class TelaServico
  class TelaAgenda
}

package "controller" {
  class ControladorCliente
  class ControladorVeiculo
  class ControladorServico
  class ControladorAgendamento
}

Cliente "1" <-- "0..*" Veiculo : proprietário
Veiculo "1" <-- "0..*" Agendamento : veículo agendado
TipoServico "1" <-- "0..*" Agendamento : serviço escolhido
Agendamento --> StatusAgendamento

ControladorCliente --> TelaCliente
ControladorCliente --> ServicoCliente
ControladorVeiculo --> TelaVeiculo
ControladorVeiculo --> ServicoVeiculo
ControladorVeiculo --> ServicoCliente
ControladorAgendamento --> TelaAgenda
ControladorAgendamento --> ServicoAgendamento
ControladorAgendamento --> ServicoVeiculo
ControladorAgendamento --> ServicoTipoServico

ServicoCliente ..> Cliente
ServicoVeiculo ..> Veiculo
ServicoTipoServico ..> TipoServico
ServicoAgendamento ..> Agendamento
@enduml
